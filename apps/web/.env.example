# Copy to .env.local. NEVER commit actual secrets or customer details.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only invited Supabase Auth emails may enter the admin panel.
ADMIN_EMAILS=owner@example.se

# Two independent random secrets, each at least 32 characters.
ORDER_RATE_LIMIT_SECRET=
ORDER_LINK_SECRET=

# Orders are disabled until legal text, prices and business accounts are approved.
ORDERS_ENABLED=false

# Test keys first. Business-owned Stripe account, not developer's personal account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SWISH_ENABLED=false
STRIPE_LIVE_ENABLED=false
# Valfri Stripe Dashboard-konfiguration; aktivera endast de metoder företaget verifierat.
STRIPE_PAYMENT_METHOD_CONFIGURATION=

# Tillåt Expo web på ett annat ursprung. Komma-separerad lista, aldrig *.
MOBILE_WEB_ORIGINS=http://localhost:8081

# Frivilliga ägarpushnotiser kräver EAS/FCM/APNs och registrerad Expo-pushtoken.
# Mejl skickas alltid separat även när push används.
OWNER_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# Messages; verified sending domain required.
RESEND_API_KEY=
EMAIL_FROM=Cedar Mezze <orders@example.se>
OWNER_NOTIFICATION_EMAIL=owner@example.se

# Official links only, not invented reviews, maps or handles.
GOOGLE_REVIEW_URL=
GOOGLE_MAPS_URL=
INSTAGRAM_URL=
FACEBOOK_URL=
TIKTOK_URL=

# Keep hidden from public search until the legal name, content and domain are approved.
NEXT_PUBLIC_INDEXABLE=false
