# Copy to .env.local. NEVER commit actual secrets or customer details.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only invited Supabase Auth emails may enter the admin panel.
ADMIN_EMAILS=owner@example.se

# Two independent random secrets, each at least 32 characters.
ORDER_RATE_LIMIT_SECRET=
ORDER_LINK_SECRET=

# Orders are disabled until legal text, prices and business accounts are approved.
ORDERS_ENABLED=false

# Avstängt tills företaget godkänt leverantör, konto och tester.
PAYMENTS_ENABLED=false
PAYMENT_INTEGRATION_APPROVED=
PAYMENT_PROVIDER=
ADYEN_ENVIRONMENT=test
# Får ändras först efter uttryckligt ägarbeslut och verifierad riktig sandbox.
PAYMENTS_LIVE_APPROVED=false
# Kopieras från det godkända livekontots API URLs > Prefix; är ingen hemlig nyckel.
ADYEN_LIVE_URL_PREFIX=
# Sätt automatic först när rätt kontos omedelbara automatiska capture har verifierats.
ADYEN_CAPTURE_MODE=
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_HMAC_KEY=
# swish,card,apple_pay,google_pay – bara avtalsaktiverade och sandboxverifierade metoder.
ADYEN_ENABLED_METHODS=
# PAYMENTS_ENABLED stoppar nya betalningar. Behåll konto/HMAC för väntande verifierade webhooks.

# Tillåt Expo web på ett annat ursprung. Komma-separerad lista, aldrig *.
MOBILE_WEB_ORIGINS=http://localhost:8081

# Frivilliga ägarpushnotiser kräver EAS/FCM/APNs och registrerad Expo-pushtoken.
# Mejl skickas alltid separat även när push används.
OWNER_PUSH_ENABLED=false
CUSTOMER_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# Messages; verified sending domain required.
NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=Cedar Mezze <orders@example.se>
OWNER_NOTIFICATION_EMAIL=owner@example.se
KITCHEN_BACKUP_EMAIL=

# Distinct random server-only secret, at least 32 characters. Never expose as NEXT_PUBLIC_.
BACKGROUND_JOB_SECRET=
BACKGROUND_JOB_URL=http://127.0.0.1:3000/api/internal/jobs
BACKGROUND_JOB_INTERVAL_MS=60000

# Official links only, not invented reviews, maps or handles.
GOOGLE_REVIEW_URL=
GOOGLE_MAPS_URL=
INSTAGRAM_URL=
FACEBOOK_URL=
TIKTOK_URL=

# Keep hidden from public search until the legal name, content and domain are approved.
NEXT_PUBLIC_INDEXABLE=false
