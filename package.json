{
  "name": "yehabibi",
  "version": "4.4.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @yehabibi/web",
    "dev:web": "npm run dev --workspace @yehabibi/web",
    "dev:mobile": "npm run start --workspace @yehabibi/mobile",
    "dev:remote": "node --experimental-strip-types scripts/remote-dev.mjs",
    "dev:remote:stop": "node --experimental-strip-types scripts/remote-dev.mjs --stop",
    "dev:remote:doctor": "node --experimental-strip-types scripts/remote-dev.mjs --doctor",
    "dev:remote:devices": "node --experimental-strip-types scripts/remote-dev.mjs --devices",
    "server:install": "powershell.exe -NoProfile -NonInteractive -File scripts/remote-server.ps1 -Mode Install",
    "server:remove": "powershell.exe -NoProfile -NonInteractive -File scripts/remote-server.ps1 -Mode Uninstall",
    "server:status": "powershell.exe -NoProfile -NonInteractive -File scripts/remote-server.ps1 -Mode Status",
    "test:remote": "node --experimental-strip-types tests/remote-integration.mjs",
    "test:metro": "node --experimental-strip-types tests/remote-metro-integration.mjs",
    "test:tailscale": "node --experimental-strip-types tests/remote-serve-integration.mjs",
    "android": "npm run android --workspace @yehabibi/mobile",
    "build:android": "npm run build:android --workspace @yehabibi/mobile",
    "build": "npm run build --workspace @yehabibi/web",
    "start": "npm run start --workspace @yehabibi/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.mjs",
    "test:integration": "node --experimental-strip-types tests/integration.mjs",
    "test:web": "node tests/web-smoke.mjs",
    "test:hospitality": "node --experimental-strip-types tests/hospitality-integration.mjs",
    "verify": "npm run syntax && npm run typecheck && npm test && npm run build && npm run export:mobile",
    "syntax": "node scripts/check-source.cjs",
    "lint": "npm run syntax",
    "export:mobile": "npm run export --workspace @yehabibi/mobile",
    "test:server": "node --experimental-strip-types scripts/test-server.mjs",
    "test:mode": "node --experimental-strip-types tests/test-mode-integration.mjs",
    "test:direct": "node --experimental-strip-types tests/direct-orders-integration.mjs",
    "test:mobile": "node --experimental-strip-types scripts/test-server.mjs --mobile",
    "jobs:worker": "node scripts/background-worker.mjs",
    "jobs:once": "node scripts/background-worker.mjs --once",
    "test:background": "node --experimental-strip-types tests/background-integration.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@expo/ngrok": "4.1.3",
    "@electric-sql/pglite": "0.5.10",
    "typescript": "5.9.3",
    "@types/node": "22.20.5"
  },
  "type": "module",
  "overrides": {
    "@expo/ngrok": {
      "uuid": "11.1.1"
    }
  }
}
